Bootstrap: docker
From: ubuntu:22.04

%post
    # Update package list and install prerequisites
    apt-get update && apt-get install -y \
        wget \
        curl \
        ca-certificates \
        bzip2 \
        libglib2.0-0 \
        libxext6 \
        libsm6 \
        libxrender1

    # Install micromamba
    MICROMAMBA_URL="https://micromamba.snakepit.net/api/micromamba/linux-64/latest"
    MICROMAMBA_DIR=/opt/app-s1ifr/micromamba
    mkdir -p $MICROMAMBA_DIR/bin
    curl -L $MICROMAMBA_URL -o $MICROMAMBA_DIR/bin/micromamba
    chmod +x $MICROMAMBA_DIR/bin/micromamba

    # Add micromamba to PATH
    export PATH=$MICROMAMBA_DIR/bin:$PATH

    # Create a micromamba environment with Python 3.12
    ENV_DIR=/opt/app-s1ifr/python
    $MICROMAMBA_DIR/bin/micromamba create --yes --root-prefix $MICROMAMBA_DIR -p $ENV_DIR python=3.12

    # Activate the environment in the container's shell
    echo "export PATH=$ENV_DIR/bin:\$PATH" >> /environment

    # Cleanup
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    # Set environment variables
    export PATH=/opt/app-s1ifr/python/bin:/opt/app-s1ifr/micromamba/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    # Default command to run Python
    exec python "$@"
